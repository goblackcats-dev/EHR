dKey":"lisinopril","drugClass":"ACE inhibitor","dose":"10 mg","route":"Oral","importantInfo":"Check blood pressure and heart rate BEFORE giving. Hold and notify the provider for SBP below 100. Watch for dizziness, dry cough, and swelling of the lips or face (angioedema: call for help). Teach to rise slowly.","monitoringRules":[{"label":"Blood Pressure","sourceType":"vital","code":"BP"},{"label":"Heart Rate","sourceType":"vital","code":"HR"}],"highAlert":false,"freqKey":"daily","prn":false,"at":[],"hold":"Hold and notify the provider if SBP is below 100 or the patient is dizzy.","expires":"","barcode":"","expiredDecoy":false,"edited":false,"custom":false},"mar":{"category":"scheduled","orderStartIndex":0,"adminDose":"10 mg","dispenseLocation":"Pharmacy to load in ADS","completed":false,"lastAdmin":""}},{"id":"order_med_insulin_lispro_ssi_1","name":"insulin lispro (HUMALOG) injection","category":"Medication","status":"Active","frequency":"Daily","start":"2026-10-20 04:45","end":"","orderedAt":"2026-10-20 04:39","provider":"S. Patel, MD","instructions":"Check the blood glucose, then give insulin lispro SubQ by the LOW-DOSE sliding scale (glucose mg/dL: 150-199 = 2 units; 200-249 = 4 units; 250-299 = 6 units; 300-349 = 8 units; 350 or higher = 10 units and call the provider; below 150 = no insulin).","rationale":"Hyperglycemia (sliding-scale insulin)","linkedData":[],"nursingConsiderations":["Hold and notify the provider if glucose is below 70 mg/dL or the patient is not eating."],"medication":{"medKey":"insulin_lispro_ssi","drugClass":"Rapid-acting insulin","dose":"Per low-dose sliding scale","route":"Subcutaneous","importantInfo":"HIGH-ALERT. LOW-DOSE sliding scale (glucose mg/dL: 150-199 = 2 units; 200-249 = 4 units; 250-299 = 6 units; 300-349 = 8 units; 350 or higher = 10 units and call the provider; below 150 = no insulin). Check the glucose BEFORE giving, find the dose on the scale, and have a second nurse verify the dose per policy. Give within 15 minutes of a meal. Rotate sites (abdomen, thigh, upper arm). Watch for hypoglycemia: sweating, shakiness, confusion.","monitoringRules":[{"label":"Glucose","sourceType":"lab","code":"Glucose"}],"highAlert":true,"freqKey":"daily","prn":false,"at":[],"hold":"Hold and notify the provider if glucose is below 70 mg/dL or the patient is not eating.","expires":"","barcode":"","expiredDecoy":false,"edited":false,"custom":false},"mar":{"category":"scheduled","orderStartIndex":0,"adminDose":"Per low-dose sliding scale","dispenseLocation":"Pharmacy to load in ADS","completed":false,"lastAdmin":"","concentration":"100 units/mL"}},{"id":"order_med_cyanocobalamin_2","name":"cyanocobalamin (VITAMIN B12) injection","category":"Medication","status":"Active","frequency":"Daily","start":"2026-10-20 04:45","end":"","orderedAt":"2026-10-20 04:39","provider":"S. Patel, MD","instructions":"Administer 1,000 mcg Intramuscular Daily.","rationale":"Vitamin B12 deficiency","linkedData":[],"nursingConsiderations":[],"medication":{"medKey":"cyanocobalamin","drugClass":"Vitamin B12","dose":"1,000 mcg","route":"Intramuscular","importantInfo":"Give deep IM in the ventrogluteal or deltoid site (1,000 mcg/mL); use a 1-1.5 inch needle (22-25 gauge), rotate sites and aspirate per policy. Check for allergy to cobalt/B12. Teach about monthly injections after the first week.","monitoringRules":[],"highAlert":false,"freqKey":"daily","prn":false,"at":[],"hold":"","expires":"","barcode":"","expiredDecoy":false,"edited":false,"custom":false},"mar":{"category":"scheduled","orderStartIndex":0,"adminDose":"1,000 mcg = 1 mL","dispenseLocation":"Pharmacy to load in ADS","completed":false,"lastAdmin":"","concentration":"1,000 mcg/mL"}}],"administrations":[{"id":"admin_order_med_lisinopril_0_d0","orderId":"order_med_lisinopril_0","slotIndex":1,"time":"0900","state":"due","label":"0900 Due","dose":"10 mg","route":"Oral"},{"id":"admin_order_med_insulin_lispro_ssi_1_d0","orderId":"order_med_insulin_lispro_ssi_1","slotIndex":1,"time":